<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="1dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/refreshScanButton"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Discovery"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Scanning for nearby peers..."
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshScanButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/surface_variant"
            android:text="Scan"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Transport Filter Tabs (All / Bluetooth / WiFi Direct) in Pill Style -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabAll"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            android:text="All"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBluetooth"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/surface"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            android:text="Bluetooth"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabWifi"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.1"
            android:backgroundTint="@color/surface"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            android:text="Wi-Fi"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Section 1: Connected Devices -->
            <TextView
                android:id="@+id/connectedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="CONNECTED PEERS"
                android:textColor="@color/accent_emerald_dark"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/connectedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_device" />

            <TextView
                android:id="@+id/noConnectedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_card_surface"
                android:padding="14dp"
                android:text="No peers currently connected. Bring phones within Bluetooth / Wi-Fi range."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <!-- Section 2: Available Devices -->
            <TextView
                android:id="@+id/availableHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="AVAILABLE IN RANGE"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/availableRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_device" />

            <TextView
                android:id="@+id/noAvailableText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_card_surface"
                android:padding="14dp"
                android:text="Scanning for nearby emergency devices..."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
