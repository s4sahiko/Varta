<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer shadow/depth ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A121417" />
        </shape>
    </item>
    <!-- Middle accent stroke -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#262A34" />
            <stroke android:width="1.5dp" android:color="#3B4252" />
        </shape>
    </item>
    <!-- Inner sleek solid obsidian disc -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:startColor="#2A303C"
                android:endColor="#121417" />
        </shape>
    </item>
</layer-list>
