<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing emerald outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3310B981" />
        </shape>
    </item>
    <!-- Middle ring with bright emerald border -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#064E3B" />
            <stroke android:width="2.5dp" android:color="#10B981" />
        </shape>
    </item>
    <!-- Inner vibrant emerald core -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="65dp"
                android:startColor="#10B981"
                android:endColor="#047857" />
        </shape>
    </item>
</layer-list>
